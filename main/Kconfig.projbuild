menu "Jinjian Battery SOC Module"

    config JINJIAN_JK_UART_NUM
        int "Jikong BMS UART number"
        default 0
        range 0 2
        help
            ESP32-S3 UART peripheral connected to the Jikong BMS.

    config JINJIAN_JK_TX_GPIO
        int "Jikong BMS TX GPIO"
        default 2
        help
            第一路 RS485（THVD1406DR）的 D 脚：ESP32-S3 的 UART TX。

    config JINJIAN_JK_RX_GPIO
        int "Jikong BMS RX GPIO"
        default 1
        help
            第一路 RS485（THVD1406DR）的 R 脚：ESP32-S3 的 UART RX。

    config JINJIAN_JK_BAUD
        int "Jikong BMS baud rate"
        default 115200
        help
            Jikong RS485 Modbus protocol physical layer baud rate.

    config JINJIAN_JK_SLAVE_ADDR
        hex "Jikong BMS Modbus slave address"
        default 0x01
        range 1 247
        help
            Modbus address configured in the Jikong BMS.

    config JINJIAN_JK_POLL_INTERVAL_MS
        int "Jikong BMS poll interval (ms)"
        default 3000
        range 100 60000
        help
            How often the module refreshes the Jikong BMS cache.

    config JINJIAN_JK_RESPONSE_TIMEOUT_MS
        int "Jikong BMS response timeout (ms)"
        default 150
        range 10 2000
        help
            Timeout for one Jikong Modbus read transaction.

    config JINJIAN_JK_FAST_CHARGE_CURRENT_MA
        int "Fast charge current threshold (mA)"
        default 0
        range 0 200000
        help
            Jikong has no fast-charge status. The module reports fast charging when
            the battery is charging and current is >= this threshold.

    config JINJIAN_LOW_TEMP_CHARGE_C
        int "Low temperature charge threshold (C)"
        default -10
        range -60 30
        help
            Extra guard used when the Jikong alarm word has no low-temp charge bit set.

    config JINJIAN_LOW_TEMP_DISCHARGE_C
        int "Low temperature discharge threshold (C)"
        default -20
        range -60 30
        help
            Jikong public protocol has no discharge low-temp alarm bit; the module
            derives this protection flag from the battery temperatures.

    config JINJIAN_CHARGE_TARGET_SOC_DEFAULT
        int "Default charge target SOC (%)"
        default 90
        range 0 100
        help
            Jikong has no charge target SOC register. This value is served as
            Jinjian register 1090 and can be changed by the vehicle.

    config JINJIAN_VEH_UART_NUM
        int "Vehicle RS485 UART number"
        default 1
        range 0 2
        help
            ESP32-S3 UART peripheral connected to the vehicle RS485 bus.

    config JINJIAN_VEH_TX_GPIO
        int "Vehicle RS485 TX GPIO"
        default 4
        help
            第二路 RS485（THVD1406DR）的 D 脚：ESP32-S3 的 UART TX。

    config JINJIAN_VEH_RX_GPIO
        int "Vehicle RS485 RX GPIO"
        default 3
        help
            第二路 RS485（THVD1406DR）的 R 脚：ESP32-S3 的 UART RX。

    config JINJIAN_VEH_BAUD
        int "Vehicle RS485 baud rate"
        default 9600
        help
            Jinjian BMS bus physical layer baud rate.

    config JINJIAN_VEH_SLAVE_ADDR
        hex "Vehicle-facing Modbus slave address"
        default 0x01
        range 1 247
        help
            Address the module answers on the Jinjian BMS bus.

    config JINJIAN_LTE_ENABLE
        bool "Enable ML307 4G (LTE) module"
        default y
        help
            启用 ML307-NL 4G 模块（AT 指令）。模块上电入网后建立到 MQTT broker
            的 TCP 连接，采集数据按 BMSStateHistory 压缩格式上报（见 README
            「MQTT 上报」）。可在 Web 页面“4G / MQTT 上报”里修改并保存。

    config JINJIAN_LTE_UART_NUM
        int "4G module UART number"
        default 2
        range 0 2
        help
            ESP32-S3 UART peripheral connected to the ML307 module.

    config JINJIAN_LTE_TX_GPIO
        int "4G module ESP TX GPIO"
        default 12
        help
            ESP32-S3 GPIO → ML307 模块 RX（模块接收脚）。

    config JINJIAN_LTE_RX_GPIO
        int "4G module ESP RX GPIO"
        default 11
        help
            ESP32-S3 GPIO ← ML307 模块 TX（模块发送脚）。

    config JINJIAN_LTE_EN_GPIO
        int "4G module EN / PWR_ON GPIO"
        default 13
        range -1 48
        help
            ML307 EN（PWR_ON/OFF）控制脚；-1 表示由硬件常开，固件不控制。

    config JINJIAN_LTE_EN_ACTIVE_LOW
        bool "4G EN is active low"
        default y
        help
            ML307 PWR_ON/OFF 低电平有效，默认勾选。若板上 EN 是高电平使能的
            电源开关，取消勾选。

    config JINJIAN_LTE_EN_PULSE_MS
        int "4G EN pulse width (ms, 0 = level enable)"
        default 2000
        range 0 10000
        help
            >0：按 PWR_ON/OFF 按键方式，先输出有效电平 JINJIAN_LTE_EN_PULSE_MS
            毫秒再释放（ML307 开机需 ≥1.5s）；
            0：保持有效电平不变（EN 直接使能电源开关）。

    config JINJIAN_LTE_BAUD
        int "4G module baud rate"
        default 115200
        help
            ML307 AT 口波特率，默认 115200 8N1。

    config JINJIAN_LTE_APN
        string "4G APN (empty = module default)"
        default ""
        help
            留空使用模块/SIM 默认 APN；填写后开机流程会先执行
            AT+CGDCONT 与 AT+MIPCALL 激活 PDP。

    config JINJIAN_MQTT_ENABLE
        bool "Enable MQTT uplink (BMSStateHistory)"
        default y
        help
            启用采集上报：采样电池数据 → 压缩编码 → MQTT 发布。

    config JINJIAN_MQTT_BROKER_HOST
        string "MQTT broker host or IP"
        default "399.run"
        help
            MQTT broker 域名或 IP（4G 模块的 TCP 目标）。留空则只入网不上报。

    config JINJIAN_MQTT_BROKER_PORT
        int "MQTT broker port"
        default 1883
        range 1 65535

    config JINJIAN_MQTT_USERNAME
        string "MQTT username (empty = anonymous)"
        default "mqtt"

    config JINJIAN_MQTT_PASSWORD
        string "MQTT password"
        default "test"

    config JINJIAN_MQTT_TOPIC_PREFIX
        string "MQTT topic prefix"
        default "/bms"
        help
            主题前缀，实际使用 <prefix>/<device_id>/status（上报）、
            <prefix>/<device_id>/call（下行）、<prefix>/<device_id>/reply（回复）。
            device_id 优先取 4G 模块 IMEI，取不到时回退本机 PN。

    config JINJIAN_MQTT_SAMPLE_INTERVAL_MS
        int "BMS sample interval (ms)"
        default 1000
        range 200 60000
        help
            采样周期，默认每秒 1 条（与 mqttagent 一致）。

    config JINJIAN_MQTT_BATCH_SAMPLES
        int "Samples per MQTT batch"
        default 30
        range 1 30
        help
            每批样本数，攒满后编码成一条 BMSStateHistory 报文发布；
            默认 30 条（1 秒采样时约 30 秒一包）。

    config JINJIAN_MQTT_KEEPALIVE_S
        int "MQTT keepalive (s)"
        default 60
        range 15 600
        help
            MQTT 保活周期，实际按一半时间发送 PINGREQ。

    config JINJIAN_BMS_TRANSPORT
        string "Default BMS transport"
        default "uart"
        help
            Default data source: "uart" (极空 485) 或 "ble"（极空蓝牙）。
            可在 Web 页面修改并保存。

    config JINJIAN_AP_SSID
        string "SoftAP SSID"
        default "Jinjian-BMS"
        help
            ESP32 热点名称。

    config JINJIAN_AP_PASSWORD
        string "SoftAP password"
        default "12345678"
        help
            ESP32 热点密码，至少 8 位。

    config JINJIAN_BLE_TARGET_NAME
        string "Jikong BLE name filter"
        default "JK"
        help
            极空 BMS 广播名子串（大小写不敏感）；留空则按 MAC 连接。

    config JINJIAN_BLE_TARGET_ADDR
        string "Jikong BLE MAC address"
        default ""
        help
            形如 aa:bb:cc:dd:ee:ff；留空则按名称过滤。

    config JINJIAN_BLE_PROTOCOL
        int "Jikong BLE protocol version"
        default 2
        range 2 3
        help
            2=JK02 24S，3=JK02 32S。

    config JINJIAN_BLE_POLL_INTERVAL_MS
        int "Jikong BLE poll interval (ms)"
        default 5000
        range 1000 60000

    config JINJIAN_BLE_SCAN_TIMEOUT_MS
        int "Jikong BLE scan timeout (ms)"
        default 20000
        range 1000 120000

    config JINJIAN_BLE_RECONNECT_INTERVAL_MS
        int "Jikong BLE reconnect interval (ms)"
        default 10000
        range 1000 120000

    config JINJIAN_LOG_STREAM_PORT
        int "Realtime log stream port"
        default 8080
        range 1024 65535
        help
            独立 HTTP chunked 日志流端口，主管理页在 80 端口保持可用。

    config JINJIAN_MAX_LOG_STREAMS
        int "Max concurrent log streams"
        default 1
        range 1 8
        help
            日志流客户端数量固定为 1；新客户端连接时会直接关闭旧连接，
            始终只保留最新一个客户端。

    config JINJIAN_LOG_LEVEL_DEFAULT
        int "Default log level"
        default 3
        range 0 5
        help
            0=NONE 1=ERROR 2=WARN 3=INFO 4=DEBUG 5=VERBOSE。
            可在 Web 页面动态调整并持久化。

    config JINJIAN_LED_ENABLE_DEFAULT
        bool "LED indicators enabled by default"
        default y
        help
            上电默认开启状态指示灯；可在 Web 页面“配置”里随时开关，
            保存后立即生效（无需重启）。

    config JINJIAN_PWR_LED_GPIO
        int "Power LED GPIO (-1 = hardwired)"
        default -1
        range -1 48
        help
            电源 LED 所在的 GPIO。若电源 LED 是硬接电源（不受 MCU 控制），
            保持 -1；配置为具体引脚后，固件会让它常亮（LED 总开关关闭时熄灭）。

    config JINJIAN_PWR_LED_ACTIVE_LOW
        bool "Power LED is active low"
        default n
        help
            电源 LED 为低电平点亮时勾选。

    config JINJIAN_STATUS_LED_GPIO
        int "Status LED GPIO"
        default -1
        range -1 48
        help
            单色状态 LED（任务成功提示）。本板（ESP32-S3）只焊了一颗 WS2812、
            没有单色 LED，默认 -1 表示未接；接了就填对应 GPIO。

    config JINJIAN_STATUS_LED_ACTIVE_LOW
        bool "Status LED is active low"
        default n
        help
            状态 LED 为低电平点亮时勾选。

    config JINJIAN_WS2812_GPIO
        int "WS2812 RGB LED GPIO"
        default 48
        range -1 48
        help
            WS2812 数据脚（本板为 GPIO48）；-1 表示未接。

    config JINJIAN_WS2812_LED_COUNT
        int "WS2812 LED count"
        default 1
        range 1 8
        help
            串联的 WS2812 灯珠数量，默认 1。

    config JINJIAN_FACTORY_RESET_GPIO
        int "Factory reset BOOT GPIO"
        default 0
        range 0 48
        help
            BOOT 键 GPIO（ESP32-S3 开发板为 GPIO0）。
            启动时按住超过 JINJIAN_FACTORY_RESET_HOLD_MS 会清空配置并重启。

    config JINJIAN_FACTORY_RESET_ACTIVE_LOW
        bool "Factory reset button is active low"
        default y
        help
            多数开发板 BOOT 按键按下接地（低电平有效）。若你的板子按键
            按下为高电平，取消勾选。

    config JINJIAN_FACTORY_RESET_HOLD_MS
        int "Factory reset hold time (ms)"
        default 3000
        range 1000 10000
        help
            长按 BOOT 键恢复出厂设置的持续时间。

    config JINJIAN_IDLE_LOW_POWER
        bool "Auto low-power when no WiFi client"
        default y
        help
            无 WiFi 客户端连接持续 JINJIAN_IDLE_TIMEOUT_MS 后，自动关闭
            LED、日志流、Web/WiFi，只保留 BMS 采集与 Modbus 从机；
            短按 BOOT 键唤醒。可显著省电，并消除 WiFi 高优先级任务对
            485 响应时序的抢占。

    config JINJIAN_IDLE_TIMEOUT_MS
        int "Idle low-power timeout (ms)"
        default 30000
        range 5000 600000
        help
            无 WiFi 客户端多久后进入低功耗（毫秒）。

endmenu
